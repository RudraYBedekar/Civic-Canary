{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "CivicCanary",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "CivicCanary"
  },
  "runtimes": [
    {
      "name": "CivicCanaryAgent",
      "build": "CodeZip",
      "entrypoint": "agent/main.py",
      "codeLocation": "build/agentcore-runtime",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "AWS_IAM",
      "instrumentation": {
        "enableOtel": true
      },
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "CIVIC_CANARY_MODE",
          "value": "aws"
        },
        {
          "name": "STORAGE_CONFIG_SSM_PARAMETER",
          "value": "/civic-canary/storage-config"
        },
        {
          "name": "ENABLE_STRANDS_REVIEW_GRAPH",
          "value": "true"
        },
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "us.anthropic.claude-sonnet-4-20250514-v1:0"
        }
      ],
      "additionalPolicies": [
        "infra/agentcore-runtime-policy.json"
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
